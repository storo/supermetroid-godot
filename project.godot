; Native Super Metroid reconstruction. Open with Godot 4.5 or newer.
config_version=5

[application]
config/name="Super Metroid · Native Reconstruction"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Native Godot reconstruction from locally extracted ROM assets and room data. Work in progress."

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.018, 0.029, 0.052, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
buses/default_bus_layout="res://assets/default_bus_layout.tres"
